# SONIC JOBS API: public HTTPS in front of the backend, which listens on 127.0.0.1:8790 only.
# Installed by deploy/enable-public-api.sh (do not copy by hand; __HOST__ is filled in by the script).
#
#   browser -> https://<dashboard>.vercel.app/api/*   (Vercel rewrite, same origin for the session cookie)
#           -> https://__HOST__/api/*                 (this site)
#           -> http://127.0.0.1:8790/api/*
#
# Only /api/ is forwarded. The dashboard pages are served by Vercel, so everything else answers 404.
# Own file and own certificate: it does not touch the other sites on this server.
# To remove: deploy/enable-public-api.sh --remove

limit_req_zone $binary_remote_addr zone=sonic_jobs_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    server_tokens off;

    # Let's Encrypt HTTP-01 challenge (shared webroot on this server).
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

